    <item>
      <title>ods-select</title>
      <link>http://localhost:1313/widget-tricks/ods-select/</link>
      <pubDate>Sun, 20 Mar 2022 00:00:00 +0000</pubDate>
      <guid>http://localhost:1313/widget-tricks/ods-select/</guid>
      <description>&lt;p&gt;ods-select allows the selection of one or more items from a list of options. This resource present different combination with ods-facet-results or ods-analysis to feed the selection list.&lt;/p&gt;&#xA;&lt;p&gt;&lt;a href=&#34;https://help.opendatasoft.com/widgets/#/api/ods-widgets.directive:odsSelect&#34;&gt;ods-select widget documentation&lt;/a&gt;&lt;/p&gt;</description>
    </item>
    <item>
